# Used server-side by next.config.ts rewrites when running outside Docker
INTERNAL_API_URL=http://localhost:8000

# Must match backend/.env's JWT_SECRET_KEY exactly. Used only in
# middleware.ts (server-side, never shipped to the browser) to verify the
# access_token cookie's signature for route guarding. The backend remains
# the authoritative enforcement layer for every actual API call --
# this only controls which *pages* render before a request is even made.
JWT_SECRET_KEY=change-me-to-a-long-random-string
